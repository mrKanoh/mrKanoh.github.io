---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { links, person, siteMeta } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Página de error: no se indexa y no lleva canónica, Open Graph ni JSON-LD. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

// Las direcciones absolutas salen de `site` en astro.config.mjs, no del servidor local.
const origin = Astro.site ?? new URL(siteMeta.origin);
const canonical = new URL(Astro.url.pathname, origin).href;
const image = new URL(siteMeta.shareImage.path, origin).href;
const siteUrl = new URL('/', origin).href;
// JSON-LD mínimo: solo lo que el sitio ya muestra.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: siteMeta.name, url: siteUrl, inLanguage: 'es' },
    { '@type': 'Person', name: person.name, jobTitle: person.jobTitle, url: siteUrl, sameAs: [links.github, links.portfolio] },
  ],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      !noindex && (
        <>
          <script type="application/ld+json" set:html={jsonLd} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={siteMeta.name} />
          <meta property="og:locale" content="es_CL" />
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={image} />
          <meta property="og:image:width" content={String(siteMeta.shareImage.width)} />
          <meta property="og:image:height" content={String(siteMeta.shareImage.height)} />
          <meta property="og:image:alt" content={siteMeta.shareImage.alt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          {description && <meta name="twitter:description" content={description} />}
          <meta name="twitter:image" content={image} />
          <meta name="twitter:image:alt" content={siteMeta.shareImage.alt} />
        </>
      )
    }
  </head>
  <body>
    <a class="amr-skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="amr-wrap site-header__bar">
        <a class="site-header__brand" href="/" aria-label="AMR, inicio">AMR</a>
      </div>
    </header>
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="amr-wrap site-footer__bar">
        <p>{person.name}</p>
        <ul class="site-footer__links">
          <li><a href={links.portfolio}>elari.work</a></li>
          <li><a href={links.cv}>CV</a></li>
          <li><a href={links.github}>GitHub</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }
  main { flex: 1 0 auto; }

  .site-header { border-top: 4px solid var(--amr-color-window); }
  .site-header__bar {
    display: flex;
    align-items: center;
    min-height: var(--amr-space-64);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--amr-size-touch);
    font: 500 20px/28px var(--amr-font-body);
    text-decoration: none;
  }

  .site-footer { border-top: 1px solid var(--amr-color-metal); }
  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--amr-space-8) var(--amr-space-24);
    padding-block: var(--amr-space-16);
    color: var(--amr-color-muted);
    font-size: 14px;
    line-height: 20px;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--amr-space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--amr-size-touch);
    color: var(--amr-color-ink);
    text-underline-offset: 3px;
  }
</style>
